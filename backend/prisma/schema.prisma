generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum AuthTokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
  REMOVED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum SubscriptionStatus {
  PENDING
  TRIALING
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELED
  EXPIRED
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

enum SubscriptionEventType {
  CREATED
  ACTIVATED
  PLAN_CHANGED
  CYCLE_CHANGED
  RENEWED
  PAYMENT_FAILED
  CANCELED
  SUSPENDED
  REACTIVATED
  EXTENDED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
  CANCELED
}

// A gateway is only ACTIVE once every required credential and configuration value
// was supplied and validated; credentials themselves never leave the encrypted
// `credentialsCiphertext` column.
enum PaymentGatewayStatus {
  INACTIVE
  ACTIVE
}

// Lifecycle of one inbound provider event (webhook or manual replay): RECEIVED while
// it is being applied, PROCESSED once payment/subscription rows were updated,
// DUPLICATE for redeliveries, IGNORED for unmatched references, REJECTED when
// signature/amount/currency/association checks failed, FAILED when processing threw
// (the provider may retry such an event).
enum PaymentEventStatus {
  RECEIVED
  PROCESSED
  DUPLICATE
  IGNORED
  REJECTED
  FAILED
}

enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum CouponType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum IntegrationStatus {
  PENDING
  CONNECTED
  NEEDS_REAUTH
  DISCONNECTED
  ERROR
}

enum SyncJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELED
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_ON_CUSTOMER
  RESOLVED
  CLOSED
}

enum SupportPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum AnnouncementStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

model User {
  id                   String                @id @default(uuid()) @db.Uuid
  email                String                @unique @db.VarChar(320)
  passwordHash         String                @db.VarChar(255)
  status               UserStatus            @default(ACTIVE)
  emailVerifiedAt      DateTime?             @db.Timestamptz(3)
  lastLoginAt          DateTime?             @db.Timestamptz(3)
  createdAt            DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime              @updatedAt @db.Timestamptz(3)
  deletedAt            DateTime?             @db.Timestamptz(3)
  deletionRequestedAt  DateTime?             @db.Timestamptz(3)
  deletionScheduledFor DateTime?             @db.Timestamptz(3)
  profile              UserProfile?
  ownedWorkspaces      Workspace[]           @relation("WorkspaceOwner")
  memberships          WorkspaceMembership[]
  sessions             UserSession[]
  authTokens           AuthToken[]
  sentInvitations      Invitation[]          @relation("InvitationSender")
  acceptedInvitations  Invitation[]          @relation("InvitationAccepter")
  auditLogs            AuditLog[]            @relation("AuditActor")
  adminMembership      AdminMembership?

  @@index([status, deletedAt])
  @@index([createdAt])
}

model UserProfile {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @unique @db.Uuid
  displayName String?
  avatarUrl   String?
  timezone    String   @default("UTC") @db.VarChar(64)
  locale      String   @default("en") @db.VarChar(16)
  preferences Json?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  refreshTokenHash String    @unique @db.VarChar(128)
  expiresAt        DateTime  @db.Timestamptz(3)
  lastUsedAt       DateTime? @db.Timestamptz(3)
  revokedAt        DateTime? @db.Timestamptz(3)
  userAgent        String?   @db.VarChar(512)
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
}

model AuthToken {
  id         String           @id @default(uuid()) @db.Uuid
  userId     String           @db.Uuid
  purpose    AuthTokenPurpose
  tokenHash  String           @unique @db.VarChar(128)
  expiresAt  DateTime         @db.Timestamptz(3)
  consumedAt DateTime?        @db.Timestamptz(3)
  createdAt  DateTime         @default(now()) @db.Timestamptz(3)
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, consumedAt, expiresAt])
}

model Workspace {
  id                        String                    @id @default(uuid()) @db.Uuid
  name                      String                    @db.VarChar(160)
  slug                      String                    @unique @db.VarChar(100)
  ownerId                   String                    @db.Uuid
  createdAt                 DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt                 DateTime                  @updatedAt @db.Timestamptz(3)
  deletedAt                 DateTime?                 @db.Timestamptz(3)
  owner                     User                      @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  memberships               WorkspaceMembership[]
  roles                     Role[]
  invitations               Invitation[]
  subscriptions             Subscription[]
  subscriptionEvents        SubscriptionEvent[]
  payments                  Payment[]
  paymentEvents             PaymentEvent[]
  paymentRefunds            PaymentRefund[]
  redemptions               CouponRedemption[]
  connectedAccounts         ConnectedAccount[]
  accountMetricCapabilities AccountMetricCapability[]
  analyticsSnapshots        AnalyticsSnapshot[]
  socialPosts               SocialPost[]
  syncJobs                  SyncJob[]
  notifications             Notification[]
  supportTickets            SupportTicket[]
  supportMessages           SupportMessage[]
  auditLogs                 AuditLog[]
  featureFlags              FeatureFlag[]
  websites                  Website[]
  usageCounters             UsageCounter[]
  brandSettings             BrandSettings?

  @@index([ownerId, deletedAt])
  @@index([createdAt])
}

model WorkspaceMembership {
  id              String           @id @default(uuid()) @db.Uuid
  workspaceId     String           @db.Uuid
  userId          String           @db.Uuid
  status          MembershipStatus @default(ACTIVE)
  joinedAt        DateTime         @default(now()) @db.Timestamptz(3)
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(3)
  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  roles           MembershipRole[]
  notifications   Notification[]
  supportTickets  SupportTicket[]  @relation("TicketCreator")
  supportMessages SupportMessage[]

  @@unique([workspaceId, userId])
  @@unique([workspaceId, id])
  @@index([userId, status])
  @@index([workspaceId, status])
}

model Invitation {
  id           String           @id @default(uuid()) @db.Uuid
  workspaceId  String           @db.Uuid
  email        String           @db.VarChar(320)
  displayName  String?          @db.VarChar(160)
  message      String?          @db.VarChar(1000)
  tokenHash    String           @unique @db.VarChar(128)
  status       InvitationStatus @default(PENDING)
  invitedById  String           @db.Uuid
  acceptedById String?          @db.Uuid
  expiresAt    DateTime         @db.Timestamptz(3)
  acceptedAt   DateTime?        @db.Timestamptz(3)
  createdAt    DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime         @updatedAt @db.Timestamptz(3)
  workspace    Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy    User             @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: Restrict)
  acceptedBy   User?            @relation("InvitationAccepter", fields: [acceptedById], references: [id], onDelete: SetNull)
  roles        InvitationRole[]

  @@unique([workspaceId, id])
  @@index([workspaceId, email, status])
  @@index([expiresAt, status])
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  workspaceId String           @db.Uuid
  key         String           @db.VarChar(80)
  name        String           @db.VarChar(100)
  description String?
  isBuiltIn   Boolean          @default(false)
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(3)
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  memberships MembershipRole[]
  invitations InvitationRole[]

  @@unique([workspaceId, key])
  @@unique([workspaceId, id])
  @@index([workspaceId, isBuiltIn])
}

model Permission {
  id          String            @id @default(uuid()) @db.Uuid
  key         String            @unique @db.VarChar(120)
  description String?
  createdAt   DateTime          @default(now()) @db.Timestamptz(3)
  roles       RolePermission[]
  admins      AdminPermission[]
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model MembershipRole {
  workspaceId  String              @db.Uuid
  membershipId String              @db.Uuid
  roleId       String              @db.Uuid
  createdAt    DateTime            @default(now()) @db.Timestamptz(3)
  membership   WorkspaceMembership @relation(fields: [workspaceId, membershipId], references: [workspaceId, id], onDelete: Cascade)
  role         Role                @relation(fields: [workspaceId, roleId], references: [workspaceId, id], onDelete: Cascade)

  @@id([membershipId, roleId])
  @@index([workspaceId, roleId])
}

model InvitationRole {
  workspaceId  String     @db.Uuid
  invitationId String     @db.Uuid
  roleId       String     @db.Uuid
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)
  invitation   Invitation @relation(fields: [workspaceId, invitationId], references: [workspaceId, id], onDelete: Cascade)
  role         Role       @relation(fields: [workspaceId, roleId], references: [workspaceId, id], onDelete: Cascade)

  @@id([invitationId, roleId])
  @@index([workspaceId, roleId])
}

model SubscriptionPlan {
  id                   String          @id @default(uuid()) @db.Uuid
  key                  String          @unique @db.VarChar(80)
  name                 String          @db.VarChar(120)
  description          String?
  amount               Decimal         @db.Decimal(12, 2)
  annualAmount         Decimal?        @db.Decimal(12, 2)
  currency             String          @db.Char(3)
  interval             BillingInterval
  trialDays            Int             @default(0)
  seatLimit            Int
  maxConnectedAccounts Int             @default(0)
  maxWebsites          Int             @default(0)
  analyticsHistoryDays Int             @default(0)
  maxReportsPerMonth   Int             @default(0)
  maxAiRequestsPerMonth Int            @default(0)
  displayOrder         Int             @default(0)
  isActive             Boolean         @default(true)
  features             PlanFeature[]
  subscriptions        Subscription[]
  createdAt            DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime        @updatedAt @db.Timestamptz(3)

  @@index([isActive, amount])
  @@index([isActive, displayOrder])
}

model PlanFeature {
  id     String           @id @default(uuid()) @db.Uuid
  planId String           @db.Uuid
  key    String           @db.VarChar(100)
  label  String           @db.VarChar(180)
  value  String?
  plan   SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, key])
}

model Subscription {
  id                     String              @id @default(uuid()) @db.Uuid
  workspaceId            String              @db.Uuid
  planId                 String              @db.Uuid
  status                 SubscriptionStatus  @default(PENDING)
  interval               BillingInterval     @default(MONTHLY)
  provider               String?             @db.VarChar(40)
  providerCustomerId     String?             @db.VarChar(180)
  providerSubscriptionId String?             @db.VarChar(180)
  currentPeriodStart     DateTime?           @db.Timestamptz(3)
  currentPeriodEnd       DateTime?           @db.Timestamptz(3)
  cancelAtPeriodEnd      Boolean             @default(false)
  canceledAt             DateTime?           @db.Timestamptz(3)
  createdAt              DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime            @updatedAt @db.Timestamptz(3)
  workspace              Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  plan                   SubscriptionPlan    @relation(fields: [planId], references: [id], onDelete: Restrict)
  events                 SubscriptionEvent[]
  payments               Payment[]

  @@unique([provider, providerSubscriptionId])
  @@unique([workspaceId, id])
  @@index([workspaceId, status, currentPeriodEnd])
  @@index([planId, status])
}

// Metered per-calendar-month (UTC) counters used for plan report and AI request limits.
model UsageCounter {
  id           String    @id @default(uuid()) @db.Uuid
  workspaceId  String    @db.Uuid
  key          String    @db.VarChar(80)
  periodStart  DateTime  @db.Timestamptz(3)
  value        Int       @default(0)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, key, periodStart])
  @@index([workspaceId, key, periodStart])
}

model SubscriptionEvent {
  id             String                @id @default(uuid()) @db.Uuid
  workspaceId    String                @db.Uuid
  subscriptionId String                @db.Uuid
  type           SubscriptionEventType
  source         String                @db.VarChar(40)
  description    String?
  metadata       Json?
  occurredAt     DateTime              @default(now()) @db.Timestamptz(3)
  workspace      Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  subscription   Subscription          @relation(fields: [workspaceId, subscriptionId], references: [workspaceId, id], onDelete: Restrict)

  @@index([workspaceId, occurredAt])
  @@index([subscriptionId, occurredAt])
}

model Payment {
  id                String             @id @default(uuid()) @db.Uuid
  workspaceId       String             @db.Uuid
  subscriptionId    String             @db.Uuid
  // Our own transaction reference: unique across every provider so one checkout can
  // never be claimed by two workspaces or two subscriptions.
  reference         String             @unique @db.VarChar(64)
  // Optional client Idempotency-Key (namespaced with the workspace) for initialize calls.
  idempotencyKey    String?            @unique @db.VarChar(180)
  provider          String             @db.VarChar(40)
  providerReference String?            @db.VarChar(180)
  // Checkout/authorization URL returned by the gateway at initialize time; a
  // redirect back with this reference is never evidence of a successful payment.
  checkoutUrl       String?            @db.VarChar(2000)
  amount            Decimal            @db.Decimal(12, 2)
  currency          String             @db.Char(3)
  status            PaymentStatus      @default(PENDING)
  customerEmail     String?            @db.VarChar(320)
  channel           String?            @db.VarChar(60)
  failureReason     String?            @db.VarChar(300)
  // Set only after a trusted provider verification endpoint or a verified webhook
  // confirmed the outcome; verificationSource records which one.
  verifiedAt        DateTime?          @db.Timestamptz(3)
  verificationSource String?           @db.VarChar(40)
  refundedAmount    Decimal            @default(0) @db.Decimal(12, 2)
  metadata          Json?
  paidAt            DateTime?          @db.Timestamptz(3)
  refundedAt        DateTime?          @db.Timestamptz(3)
  createdAt         DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @db.Timestamptz(3)
  workspace         Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  subscription      Subscription       @relation(fields: [workspaceId, subscriptionId], references: [workspaceId, id], onDelete: Restrict)
  couponRedemptions CouponRedemption[]
  events            PaymentEvent[]
  refunds           PaymentRefund[]

  @@unique([provider, providerReference])
  @@unique([workspaceId, id])
  @@index([workspaceId, createdAt])
  @@index([subscriptionId, status])
  @@index([workspaceId, status, createdAt])
}

// Platform-scoped gateway registration. `provider` is one of the built-in adapters;
// `credentialsCiphertext` holds the AES-256-GCM encrypted JSON of secrets (secret key,
// webhook secret) and `config` holds non-secret values (environment, currency).
model PaymentGateway {
  id                     String               @id @default(uuid()) @db.Uuid
  provider               String               @unique @db.VarChar(40)
  displayName            String               @db.VarChar(80)
  status                 PaymentGatewayStatus @default(INACTIVE)
  statusReason           String?              @db.VarChar(300)
  credentialsCiphertext  String?
  config                 Json?
  activatedAt            DateTime?            @db.Timestamptz(3)
  lastTestedAt           DateTime?            @db.Timestamptz(3)
  lastTestResult         String?              @db.VarChar(60)
  createdAt              DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime             @updatedAt @db.Timestamptz(3)

  @@index([status])
}

// Every inbound gateway event (webhook delivery or operator replay) is logged before
// it is applied. `idempotencyKey` (provider + provider event id) is unique, which is
// what makes duplicate deliveries no-ops at the database level.
model PaymentEvent {
  id              String             @id @default(uuid()) @db.Uuid
  workspaceId     String?            @db.Uuid
  paymentId       String?            @db.Uuid
  provider        String             @db.VarChar(40)
  providerEventId String             @db.VarChar(200)
  idempotencyKey  String             @unique @db.VarChar(260)
  type            String             @db.VarChar(100)
  status          PaymentEventStatus @default(RECEIVED)
  signatureValid  Boolean            @default(false)
  outcome         String?            @db.VarChar(30)
  summary         String?            @db.VarChar(500)
  payload         Json?
  receivedAt      DateTime           @default(now()) @db.Timestamptz(3)
  processedAt     DateTime?          @db.Timestamptz(3)
  workspace       Workspace?         @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  payment         Payment?           @relation(fields: [workspaceId, paymentId], references: [workspaceId, id], onDelete: SetNull)

  @@unique([provider, providerEventId])
  @@index([workspaceId, receivedAt])
  @@index([paymentId, receivedAt])
  @@index([provider, status, receivedAt])
}

model PaymentRefund {
  id                String       @id @default(uuid()) @db.Uuid
  workspaceId       String       @db.Uuid
  paymentId         String       @db.Uuid
  provider          String       @db.VarChar(40)
  providerReference String?      @db.VarChar(180)
  amount            Decimal      @db.Decimal(12, 2)
  currency          String       @db.Char(3)
  status            RefundStatus @default(PENDING)
  reason            String?      @db.VarChar(300)
  failureReason     String?      @db.VarChar(300)
  requestedById     String?      @db.Uuid
  createdAt         DateTime     @default(now()) @db.Timestamptz(3)
  completedAt       DateTime?    @db.Timestamptz(3)
  workspace         Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  payment           Payment      @relation(fields: [workspaceId, paymentId], references: [workspaceId, id], onDelete: Restrict)

  @@unique([provider, providerReference])
  @@index([workspaceId, createdAt])
  @@index([paymentId, createdAt])
}

model Coupon {
  id              String             @id @default(uuid()) @db.Uuid
  code            String             @unique @db.VarChar(80)
  type            CouponType
  percentOff      Decimal?           @db.Decimal(5, 2)
  amountOff       Decimal?           @db.Decimal(12, 2)
  currency        String?            @db.Char(3)
  maxRedemptions  Int?
  redemptionCount Int                @default(0)
  startsAt        DateTime?          @db.Timestamptz(3)
  expiresAt       DateTime?          @db.Timestamptz(3)
  isActive        Boolean            @default(true)
  createdAt       DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime           @updatedAt @db.Timestamptz(3)
  redemptions     CouponRedemption[]

  @@index([isActive, startsAt, expiresAt])
}

model CouponRedemption {
  id          String    @id @default(uuid()) @db.Uuid
  couponId    String    @db.Uuid
  workspaceId String    @db.Uuid
  paymentId   String?   @db.Uuid
  redeemedAt  DateTime  @default(now()) @db.Timestamptz(3)
  coupon      Coupon    @relation(fields: [couponId], references: [id], onDelete: Restrict)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  payment     Payment?  @relation(fields: [workspaceId, paymentId], references: [workspaceId, id], onDelete: Restrict)

  @@unique([couponId, workspaceId])
  @@index([workspaceId, redeemedAt])
}

model IntegrationProvider {
  id           String                    @id @default(uuid()) @db.Uuid
  key          String                    @unique @db.VarChar(80)
  name         String                    @db.VarChar(120)
  category     String                    @db.VarChar(80)
  isEnabled    Boolean                   @default(false)
  config       Json?
  createdAt    DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime                  @updatedAt @db.Timestamptz(3)
  accounts     ConnectedAccount[]
  capabilities AccountMetricCapability[]
}

model Website {
  id          String             @id @default(uuid()) @db.Uuid
  workspaceId String             @db.Uuid
  name        String             @db.VarChar(160)
  domain      String             @db.VarChar(253)
  createdAt   DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime           @updatedAt @db.Timestamptz(3)
  deletedAt   DateTime?          @db.Timestamptz(3)
  workspace   Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  accounts    ConnectedAccount[]

  @@unique([workspaceId, domain])
  @@unique([workspaceId, id])
  @@index([workspaceId, deletedAt])
}

model ConnectedAccount {
  id                    String                    @id @default(uuid()) @db.Uuid
  workspaceId           String                    @db.Uuid
  providerId            String                    @db.Uuid
  providerAccountId     String                    @db.VarChar(180)
  websiteId             String?                   @db.Uuid
  displayName           String                    @db.VarChar(180)
  status                IntegrationStatus         @default(PENDING)
  credentialsCiphertext String?
  credentialsExpiresAt  DateTime?                 @db.Timestamptz(3)
  lastSyncedAt          DateTime?                 @db.Timestamptz(3)
  createdAt             DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime                  @updatedAt @db.Timestamptz(3)
  deletedAt             DateTime?                 @db.Timestamptz(3)
  workspace             Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  provider              IntegrationProvider       @relation(fields: [providerId], references: [id], onDelete: Restrict)
  website               Website?                  @relation(fields: [workspaceId, websiteId], references: [workspaceId, id], onDelete: Restrict)
  capabilities          AccountMetricCapability[]
  snapshots             AnalyticsSnapshot[]
  posts                 SocialPost[]
  syncJobs              SyncJob[]

  @@unique([workspaceId, providerId, providerAccountId])
  @@unique([workspaceId, id])
  @@unique([providerId, id])
  @@unique([workspaceId, providerId, id])
  @@index([workspaceId, status, deletedAt])
  @@index([providerId, status])
}

model AnalyticsMetric {
  id           String                    @id @default(uuid()) @db.Uuid
  key          String                    @unique @db.VarChar(100)
  name         String                    @db.VarChar(140)
  unit         String?                   @db.VarChar(40)
  aggregation  String                    @db.VarChar(30)
  createdAt    DateTime                  @default(now()) @db.Timestamptz(3)
  capabilities AccountMetricCapability[]
  snapshots    AnalyticsSnapshot[]
}

model AccountMetricCapability {
  id          String              @id @default(uuid()) @db.Uuid
  workspaceId String              @db.Uuid
  providerId  String              @db.Uuid
  metricId    String              @db.Uuid
  accountId   String              @db.Uuid
  workspace   Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  provider    IntegrationProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  metric      AnalyticsMetric     @relation(fields: [metricId], references: [id], onDelete: Cascade)
  account     ConnectedAccount    @relation(fields: [workspaceId, providerId, accountId], references: [workspaceId, providerId, id], onDelete: Cascade)

  @@unique([workspaceId, providerId, metricId, accountId])
  @@index([workspaceId, metricId])
}

model AnalyticsSnapshot {
  id          String           @id @default(uuid()) @db.Uuid
  workspaceId String           @db.Uuid
  accountId   String           @db.Uuid
  metricId    String           @db.Uuid
  periodStart DateTime         @db.Timestamptz(3)
  periodEnd   DateTime         @db.Timestamptz(3)
  value       Decimal          @db.Decimal(24, 6)
  dimensions  Json?
  collectedAt DateTime         @default(now()) @db.Timestamptz(3)
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account     ConnectedAccount @relation(fields: [workspaceId, accountId], references: [workspaceId, id], onDelete: Cascade)
  metric      AnalyticsMetric  @relation(fields: [metricId], references: [id], onDelete: Restrict)

  @@unique([workspaceId, accountId, metricId, periodStart, periodEnd])
  @@index([workspaceId, metricId, periodStart])
  @@index([accountId, periodStart])
}

model SocialPost {
  id               String           @id @default(uuid()) @db.Uuid
  workspaceId      String           @db.Uuid
  accountId        String           @db.Uuid
  providerPostId   String           @db.VarChar(180)
  postType         String?          @db.VarChar(60)
  text             String?
  permalink        String?
  publishedAt      DateTime?        @db.Timestamptz(3)
  providerMetadata Json?
  createdAt        DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @db.Timestamptz(3)
  deletedAt        DateTime?        @db.Timestamptz(3)
  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account          ConnectedAccount @relation(fields: [workspaceId, accountId], references: [workspaceId, id], onDelete: Cascade)

  @@unique([workspaceId, accountId, providerPostId])
  @@index([workspaceId, publishedAt])
  @@index([accountId, publishedAt])
}

model SyncJob {
  id          String            @id @default(uuid()) @db.Uuid
  workspaceId String            @db.Uuid
  accountId   String?           @db.Uuid
  jobType     String            @db.VarChar(80)
  status      SyncJobStatus     @default(QUEUED)
  attempts    Int               @default(0)
  scheduledAt DateTime          @default(now()) @db.Timestamptz(3)
  startedAt   DateTime?         @db.Timestamptz(3)
  completedAt DateTime?         @db.Timestamptz(3)
  errorCode   String?           @db.VarChar(80)
  safeError   String?
  createdAt   DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime          @updatedAt @db.Timestamptz(3)
  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account     ConnectedAccount? @relation(fields: [workspaceId, accountId], references: [workspaceId, id], onDelete: Restrict)

  @@index([workspaceId, status, scheduledAt])
  @@index([accountId, status])
}

model Notification {
  id          String              @id @default(uuid()) @db.Uuid
  workspaceId String              @db.Uuid
  userId      String              @db.Uuid
  type        String              @db.VarChar(80)
  title       String              @db.VarChar(180)
  message     String
  readAt      DateTime?           @db.Timestamptz(3)
  createdAt   DateTime            @default(now()) @db.Timestamptz(3)
  workspace   Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  membership  WorkspaceMembership @relation(fields: [workspaceId, userId], references: [workspaceId, userId], onDelete: Cascade)

  @@index([workspaceId, userId, readAt, createdAt])
}

model SupportTicket {
  id          String              @id @default(uuid()) @db.Uuid
  workspaceId String              @db.Uuid
  createdById String              @db.Uuid
  subject     String              @db.VarChar(200)
  status      SupportTicketStatus @default(OPEN)
  priority    SupportPriority     @default(NORMAL)
  createdAt   DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime            @updatedAt @db.Timestamptz(3)
  closedAt    DateTime?           @db.Timestamptz(3)
  workspace   Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  createdBy   WorkspaceMembership @relation("TicketCreator", fields: [workspaceId, createdById], references: [workspaceId, userId], onDelete: Restrict)
  messages    SupportMessage[]

  @@unique([workspaceId, id])
  @@index([workspaceId, status, updatedAt])
  @@index([createdById, createdAt])
}

model SupportMessage {
  id          String               @id @default(uuid()) @db.Uuid
  workspaceId String               @db.Uuid
  ticketId    String               @db.Uuid
  senderId    String?              @db.Uuid
  isStaff     Boolean              @default(false)
  body        String
  createdAt   DateTime             @default(now()) @db.Timestamptz(3)
  workspace   Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  ticket      SupportTicket        @relation(fields: [workspaceId, ticketId], references: [workspaceId, id], onDelete: Cascade)
  sender      WorkspaceMembership? @relation(fields: [workspaceId, senderId], references: [workspaceId, userId], onDelete: Restrict)

  @@index([workspaceId, ticketId, createdAt])
}

model AuditLog {
  id          String     @id @default(uuid()) @db.Uuid
  workspaceId String?    @db.Uuid
  actorId     String?    @db.Uuid
  action      String     @db.VarChar(120)
  targetType  String     @db.VarChar(100)
  targetId    String?    @db.VarChar(180)
  metadata    Json?
  createdAt   DateTime   @default(now()) @db.Timestamptz(3)
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  actor       User?      @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([actorId, createdAt])
  @@index([targetType, targetId])
}

model AdminRole {
  id          String            @id @default(uuid()) @db.Uuid
  key         String            @unique @db.VarChar(80)
  name        String            @db.VarChar(100)
  description String?
  permissions AdminPermission[]
  memberships AdminMembership[]
  createdAt   DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime          @updatedAt @db.Timestamptz(3)
}

model AdminPermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         AdminRole  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model AdminMembership {
  userId    String    @id @db.Uuid
  roleId    String    @db.Uuid
  grantedAt DateTime  @default(now()) @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      AdminRole @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@index([roleId])
}

model BrandSettings {
  id           String     @id @default(uuid()) @db.Uuid
  workspaceId  String?    @unique @db.Uuid
  scopeKey     String     @unique @db.VarChar(140)
  name         String     @db.VarChar(160)
  logoUrl      String?
  primaryColor String?    @db.VarChar(7)
  settings     Json?
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @db.Timestamptz(3)
  workspace    Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model SystemSetting {
  key       String   @id @db.VarChar(120)
  value     Json
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

model Announcement {
  id        String             @id @default(uuid()) @db.Uuid
  title     String             @db.VarChar(180)
  body      String
  status    AnnouncementStatus @default(DRAFT)
  startsAt  DateTime?          @db.Timestamptz(3)
  endsAt    DateTime?          @db.Timestamptz(3)
  createdAt DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt DateTime           @updatedAt @db.Timestamptz(3)

  @@index([status, startsAt, endsAt])
}

model FeatureFlag {
  id          String     @id @default(uuid()) @db.Uuid
  workspaceId String?    @db.Uuid
  scopeKey    String     @unique @db.VarChar(180)
  key         String     @db.VarChar(120)
  enabled     Boolean    @default(false)
  config      Json?
  createdAt   DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime   @updatedAt @db.Timestamptz(3)
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, key])
  @@index([key, enabled])
}
