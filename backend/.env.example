NODE_ENV=development
APP_VERSION=0.1.0
# 4100, not 4000: Windows reserves TCP 3985-4084 (Hyper-V/WinNAT excluded
# port range) on many machines — binding 4000 there fails with EACCES.
PORT=4100
CORS_ORIGIN=http://localhost:3000
APP_BASE_URL=http://localhost:3000
JWT_SECRET=replace-this-with-at-least-32-random-characters
AUTH_ACCESS_TTL_SECONDS=300
AUTH_REFRESH_TTL_DAYS=30
SMTP_URL=smtp://localhost:1025
EMAIL_FROM=Metrispot <no-reply@localhost>
# false = skip the email-verification gate on login/sessions (dev until real
# email delivery is configured); unset or true = verification required (production)
EMAIL_VERIFICATION_REQUIRED=true
DATABASE_URL=postgresql://metrispot:change-me@localhost:5432/metrispot?schema=public
REDIS_URL=redis://localhost:6379

# --- Meta OAuth integrations (optional; see backend/docs/meta-integrations.md)
# Uncomment and fill to enable the flows; empty/unset = NOT_CONFIGURED at runtime.
# Facebook Login app credentials; redirect must be {APP_BASE_URL}/auth/meta/callback
#META_APP_ID=
#META_APP_SECRET=
#META_REDIRECT_URI=
# Instagram Login credentials (separate fields in the Meta App Dashboard)
#META_INSTAGRAM_APP_ID=
#META_INSTAGRAM_APP_SECRET=
#META_INSTAGRAM_REDIRECT_URI=
# Optional AES-256-GCM key for OAuth tokens at rest (falls back to
# PAYMENT_ENCRYPTION_KEY, then a JWT_SECRET derivation)
#INTEGRATIONS_ENCRYPTION_KEY=

# --- TikTok Display API (optional; see backend/docs/social-integrations.md)
# Login Kit + Display API (profile / videos only — NOT business analytics).
# Redirect must be {APP_BASE_URL}/auth/tiktok/callback
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=

# --- TikTok API for Business (optional, separate product and review)
# Advertiser metrics only. Falls back to NOT_CONFIGURED (never to Display data)
# when unset. Same callback path as above; the signed state carries the product.
#TIKTOK_BUSINESS_APP_ID=
#TIKTOK_BUSINESS_SECRET=
#TIKTOK_BUSINESS_REDIRECT_URI=

# --- X OAuth 2.0 PKCE (preferred; see backend/docs/social-integrations.md)
# Redirect must be {APP_BASE_URL}/auth/x/callback. The consumer pair below is
# the OAuth 1.0a fallback strategy, not a user authorization.
#X_CLIENT_ID=
#X_CLIENT_SECRET=
#X_REDIRECT_URI=
X_CONSUMER_KEY=
X_SECRET_KEY=
# App-only bearer token: NEVER used to read user data or private metrics.
X_BEARER_TOKEN=
# Optional OAuth 1.0a user context (for endpoints without a v2 equivalent)
#X_OAUTH1_ACCESS_TOKEN=
#X_OAUTH1_ACCESS_SECRET=

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
